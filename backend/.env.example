LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
FRONTEND_URL=http://localhost:3000

# Supabase Storage (S3-compatible) for recordings
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=your_supabase_access_key
SUPABASE_S3_SECRET_KEY=your_supabase_secret_key
SUPABASE_S3_REGION=ap-northeast-2
SUPABASE_S3_BUCKET=class-recordings
